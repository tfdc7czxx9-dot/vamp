// SteamPipe depot template (windows). NO CREDENTIALS in this file.
// Variables: DEPOTID_WINDOWS (rendered with envsubst, see README.md)
// ContentRoot (from app_build) must contain the windows player build output.
"DepotBuild"
{
	"DepotID" "${DEPOTID_WINDOWS}"

	"FileMapping"
	{
		"LocalPath" "windows/*"
		"DepotPath" "."
		"Recursive" "1"
	}

	// Never ship these (dev-only files, debug data, Unity backup folders).
	"FileExclusion" "steam_appid.txt"
	"FileExclusion" "*_BurstDebugInformation_DoNotShip*"
	"FileExclusion" "*_BackUpThisFolder_ButDontShipItWithYourGame*"
	"FileExclusion" "*.pdb"
	"FileExclusion" "*.dSYM*"
}
