<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Static compile check of the Unity presentation layer outside the Unity editor.
    References community-packaged UnityEngine reference assemblies (2021.3 API surface) plus
    hand-written stubs for the Input System / URP members used (verified against package sources).
    Catches typos and signature mistakes early; the real gate is the Unity build in CI.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <NoWarn>CS1591;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Brasslight/Assets/Scripts/Core/**/*.cs" />
    <Compile Include="../../src/Brasslight/Assets/Scripts/Platform/**/*.cs" />
    <Compile Include="../../src/Brasslight/Assets/Scripts/Game/**/*.cs" />
    <Compile Include="stubs/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
  </ItemGroup>
</Project>
